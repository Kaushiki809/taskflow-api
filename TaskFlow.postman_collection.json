{
  "info": {
    "name": "TaskFlow API \u2014 Task 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all requests in order against your own local server. Creates and deletes one sample task. Unexpected 500 errors are exercised by the automated tests using an injected failing store; no public failure endpoint exists."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"  Postman sample task  \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "const task = pm.response.json(); pm.collectionVariables.set(\"taskId\", task.id);",
              "pm.test(\"Task schema and trimming\", () => { const t=pm.response.json(); pm.expect(t.id).to.be.a(\"number\"); pm.expect(t.text).to.eql(\"Postman sample task\"); pm.expect(t.completed).to.eql(false); pm.expect(Number.isFinite(Date.parse(t.createdAt))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Array includes our task\", () => { const tasks=pm.response.json(); pm.expect(tasks).to.be.an(\"array\"); pm.expect(tasks.some(t => t.id === Number(pm.collectionVariables.get(\"taskId\")))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Read single task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Correct ID\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"taskId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Complete task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"completed\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Completed\", () => pm.expect(pm.response.json().completed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Rename and reopen task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Renamed sample\", \"completed\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Full update\", () => { const t=pm.response.json(); pm.expect(t.text).to.eql(\"Renamed sample\"); pm.expect(t.completed).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reject blank input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"   \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Consistent error\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Reject long input",
      "request": {
        "method": "POST",
